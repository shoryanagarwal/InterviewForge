generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QStatus {
  ANSWERED
  PENDING
  MISSED
}

enum Status {
  COMPLETED
  CREATED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  image      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  interviews Interview[]
}

model Interview {
  id                String     @id @default(uuid())
  user              User       @relation(fields: [userId], references: [id])
  userId            String
  role              String
  difficulty        Difficulty @default(EASY)
  status            Status     @default(CREATED)
  resumeUrl         String?
  numberOfQuestions Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  score             Int?
  feedback          Json?
  questions         Question[]
}

model Question {
  id             String    @id @default(uuid())
  topic          String
  question       String
  expectedAnswer String
  userAnswer     String?
  status         QStatus   @default(PENDING)
  score          Int?
  feedback       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  interview      Interview @relation(fields: [interviewId], references: [id])
  interviewId    String
}
